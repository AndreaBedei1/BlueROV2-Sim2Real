# ArduSub 4.1.2 SITL overlay for the Phase 2 HoloOcean bridge.
# Loaded after Tools/autotest/default_params/sub.parm (ArduPilot), which is
# kept unchanged. These are SIMULATION parameters only: they were NOT read
# from, and must NOT be written to, the real vehicle.

# Eight-thruster vectored frame, as on the laboratory vehicle (FRAME_CONFIG=2).
# The ArduSub default is 1 (SUB_FRAME_VECTORED, six thrusters).
FRAME_CONFIG     2

# Motor n on output n, as on the laboratory vehicle. sub.parm assigns output 8
# to the camera tilt (SERVO8_FUNCTION 7), which would leave motor 8 unconnected.
SERVO1_FUNCTION  33
SERVO2_FUNCTION  34
SERVO3_FUNCTION  35
SERVO4_FUNCTION  36
SERVO5_FUNCTION  37
SERVO6_FUNCTION  38
SERVO7_FUNCTION  39
SERVO8_FUNCTION  40
MNT_TYPE         0

# Logical simulated thrusters: positive command = positive mixing contribution.
# The real vehicle uses -1 on motors 1, 2, 5, 8 to compensate for propeller
# handedness; that physical property does not exist in the simulated model.
MOT_1_DIRECTION  1
MOT_2_DIRECTION  1
MOT_3_DIRECTION  1
MOT_4_DIRECTION  1
MOT_5_DIRECTION  1
MOT_6_DIRECTION  1
MOT_7_DIRECTION  1
MOT_8_DIRECTION  1

# Control loop at 200 Hz, as recorded on the vehicle (the 4.1.2 Navigator board
# build defaults to 200; the SITL build defaults to 400). SIM_RATE_HZ only
# bounds the frame_rate field SITL reports; physics runs at the bridge rate.
SCHED_LOOP_RATE  200
SIM_RATE_HZ      200

# No GPS underwater: SIM_GPS_DISABLE removes the simulated fix, GPS_TYPE 0 the
# receiver itself (SITL otherwise detects a u-blox).
SIM_GPS_DISABLE  1
GPS_TYPE         0

# Distinct MAVLink system id so that this SITL can never be mistaken for the vehicle.
SYSID_THISMAV    17

LOG_DISARMED     0

# Depth sensor model. SITL synthesises the pressure of BOTH barometers from the
# position we send, with sea water (1024 kg/m^3, g = 9.80665) and a uniform
# noise of +-SIM_BARO_RND metres (default 0.2 m, an air-altitude value). ArduSub
# converts pressure to depth as dP / (9800 * BARO_SPEC_GRAV).
# - noise: +-5 mm uniform (sigma ~3 mm), consistent with the 2.1-3.4 mm static
#   noise of the real external depth sensor measured in Phase 1;
# - BARO_SPEC_GRAV = 1024 * 9.80665 / 9800 = 1.0247 makes ArduSub's depth equal
#   to the simulated depth (on the lake vehicle the value is 1.0 for fresh
#   water, where the real pressure is generated by fresh water).
SIM_BARO_RND     0.005
SIM_BAR2_RND     0.005
BARO_SPEC_GRAV   1.0247

# Controller parameters of the laboratory vehicle (ArduSub 4.1.2 backup of
# 2026-10-05, as published in docs/phase1/hardware/hardware-inventory.it.md §8).
# sub.parm (tuned for ArduPilot's internal SITL sub model) sets the vertical
# loop ~4x more aggressive (PSC_ACCZ_P 2, I 4, VELZ_P 8, POSZ_P 3); with the
# HoloOcean plant that produced a ~3.5 Hz limit cycle in the first Test E run.
PSC_POSZ_P       1.0
PSC_VELZ_P       4.0
PSC_VELZ_I       0
PSC_ACCZ_P       0.5
PSC_ACCZ_I       0.1
PSC_ACCZ_IMAX    100
PSC_JERK_Z       50
PSC_POSXY_P      0.6
PSC_VELXY_P      6.0
PSC_VELXY_I      0.5
PSC_VELXY_D      0
PILOT_SPEED_UP   100
PILOT_SPEED_DN   0
PILOT_ACCEL_Z    100
THR_DZ           100
ATC_ANG_RLL_P    6.0
ATC_ANG_PIT_P    6.0
ATC_ANG_YAW_P    6.0
ATC_RAT_RLL_P    0.135
ATC_RAT_RLL_I    0.09
ATC_RAT_RLL_D    0.0036
ATC_RAT_RLL_IMAX 0.444
ATC_RAT_PIT_P    0.135
ATC_RAT_PIT_I    0.09
ATC_RAT_PIT_D    0.0036
ATC_RAT_PIT_IMAX 0.444
ATC_RAT_YAW_P    0.18
ATC_RAT_YAW_I    0.018
ATC_RAT_YAW_D    0
ATC_RAT_YAW_IMAX 0.222
ATC_INPUT_TC     0.15
INS_GYRO_FILTER  20
INS_ACCEL_FILTER 20

# Further parity with the vehicle backup (hardware-inventory.it.md §8):
# one IMU and one EKF3 lane (EK3_IMU_MASK=1), joystick gain, arming checks.
SIM_IMU_COUNT    1
EK3_IMU_MASK     1
JS_GAIN_DEFAULT  0.2
ARMING_CHECK     448
# Vertical acceleration feed-forward: sub.parm sets 0.75; the vehicle value is
# not recorded in the Phase 1 inventory, so the ArduSub 4.1.2 firmware default
# (0, AC_PosControl.cpp) is used. To be confirmed from the vehicle parameters.
PSC_ACCZ_FF      0
